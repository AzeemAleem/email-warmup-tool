# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/email_warmup?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Encryption key for app passwords (32 bytes hex = 64 hex chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="your-64-char-hex-encryption-key-here"

# AI Providers (at least one required for content generation)
GEMINI_API_KEY="your-gemini-api-key-here"
GROQ_API_KEY="your-groq-api-key-here"

# Session secret for dashboard auth (32+ chars random string)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="your-session-secret-here"

# Dashboard admin credentials
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-before-deploy"

# Next.js
NEXTAUTH_URL="http://localhost:3000"
NODE_ENV="development"
