# =============================================================================
# DATABASE — Supabase (recommended for Vercel + Contabo worker)
# =============================================================================
# Get all strings from Supabase → Project Settings → Database → Connection string
#
# VERCEL (Next.js dashboard — serverless, use Transaction pooler):
# DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
#
# DIRECT_URL (migrations only — use Direct connection, port 5432):
# DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require"
#
# CONTABO WORKER (long-running — use Session pooler, NOT db.*.supabase.co):
# DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"
# DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require"
#
# Local dev:
DATABASE_URL="postgresql://postgres:password@localhost:5432/email_warmup?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/email_warmup?schema=public"

# Redis (unused — Contabo worker uses setInterval timers, not BullMQ/Upstash)
# REDIS_URL="redis://localhost:6379"

# Encryption key for app passwords (32 bytes hex = 64 hex chars)
# MUST be identical on Vercel and Contabo — changing it breaks stored app passwords
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="your-64-char-hex-encryption-key-here"

# AI Providers (at least one required for content generation)
GEMINI_API_KEY="your-gemini-api-key-here"
GROQ_API_KEY="your-groq-api-key-here"

# Session secret for dashboard auth (32+ chars random string)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="your-session-secret-here"

# Dashboard admin credentials
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-before-deploy"

# Next.js
NEXTAUTH_URL="http://localhost:3000"
NODE_ENV="development"
