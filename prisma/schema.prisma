generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Account {
  id                String   @id @default(cuid())
  email             String   @unique
  displayName       String?
  role              String   // "OLD" | "NEW"
  provider          String   @default("gmail")
  appPassword       String   // encrypted at rest (AES-256-GCM)
  imapHost          String   @default("imap.gmail.com")
  imapPort          Int      @default(993)
  smtpHost          String   @default("smtp.gmail.com")
  smtpPort          Int      @default(465)
  status            String   @default("ACTIVE") // ACTIVE | PAUSED | ERROR | REMOVED
  warmupStartedAt   DateTime @default(now())
  trustWeight       Float    @default(0)   // 0.0–1.0, computed daily
  dailyTargetVolume Int      @default(0)    // recomputed daily by scheduler
  sentToday         Int      @default(0)
  lastError         String?
  timezone          String   @default("UTC")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  sentEvents        WarmupEvent[] @relation("SenderEvents")
  receivedEvents    WarmupEvent[] @relation("ReceiverEvents")
}

model WarmupEvent {
  id            String   @id @default(cuid())
  senderId      String
  receiverId    String
  sender        Account  @relation("SenderEvents", fields: [senderId], references: [id])
  receiver      Account  @relation("ReceiverEvents", fields: [receiverId], references: [id])
  subject       String
  bodyPreview   String
  messageId     String?  // IMAP message-id once discovered
  status        String   @default("QUEUED") // QUEUED | SENT | DELIVERED | OPENED | REPLIED | RESCUED_FROM_SPAM | FAILED
  scheduledFor  DateTime
  sentAt        DateTime?
  openedAt      DateTime?
  repliedAt     DateTime?
  landedInSpam  Boolean  @default(false)
  rescuedAt     DateTime?
  /// Root event id for the conversation (null on fresh OLD→NEW mail)
  threadRootId  String?
  /// 0 = fresh mail, 1 = NEW reply, 2 = OLD follow-up, 3 = NEW closing (max)
  threadDepth   Int      @default(0)
  /// True for in-thread replies — does NOT count toward inbound daily caps
  isReply       Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([status, scheduledFor])
  @@index([senderId])
  @@index([receiverId])
  @@index([messageId])
  @@index([threadRootId])
  @@index([isReply, status, sentAt])
}

model WarmupConfig {
  id                     String  @id @default("singleton")
  rampUpDays             Int     @default(28)
  startVolumePerDay      Int     @default(1)
  maxVolumePerDay        Int     @default(10)
  minDelayBetweenSendsMs Int     @default(180000)  // 3 min — same sender
  maxDelayBetweenSendsMs Int     @default(900000)  // 15 min
  replyProbability       Float   @default(0.35)
  spamRescueEnabled      Boolean @default(true)
  activeHourStart        Int     @default(8)
  activeHourEnd          Int     @default(20)
  minPairCooldownHours   Int     @default(6)
  aiProvider             String  @default("gemini") // gemini | groq | none
  timezone               String  @default("UTC")

  // Deliverability safety (used by worker — same values as Config UI)
  maxInboundPerReceiverPerDay   Int @default(3)
  maxInboundPerReceiverPerHour  Int @default(1)
  minGapBetweenInboundMs        Int @default(7200000) // 2 hours
  maxSendsPerTick               Int @default(1)
  maxSendsToSameReceiverPerTick Int @default(1)
  maxOldDailySendsWhenFewNew    Int @default(3)

  updatedAt              DateTime @updatedAt
}

model ContentTemplate {
  id         String   @id @default(cuid())
  subject    String
  body       String
  usedCount  Int      @default(0)
  createdAt  DateTime @default(now())
  lastUsedAt DateTime?
}

/// ─── Client Management ───────────────────────────────────────────────────────

model Client {
  id        String    @id @default(cuid())
  name      String
  email     String?
  phone     String?
  /// Free-form notes about how this client communicates, preferences, etc.
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  projects  Project[]

  @@index([name])
  @@index([createdAt])
}

model Project {
  id           String        @id @default(cuid())
  clientId     String
  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name         String
  /// ACTIVE | COMPLETED | ON_HOLD | CANCELLED
  status       String        @default("ACTIVE")
  /// QUOTATION = quote only | WON = order confirmed / proceeded
  dealType     String        @default("QUOTATION")
  /// Unique tracking reference (e.g. PRJ-001)
  trackingId   String?
  /// When work on the project started
  startDate    DateTime?
  /// When the project must be delivered
  deadline     DateTime?
  /// Ship-to address for this project
  shippingAddress String?
  /// Bullet-point requirements stored as a JSON string[]
  requirements Json          @default("[]")
  /// Additional notes / context for this project
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  calculations Calculation[]
  invoices     Invoice[]
  actualExpense ActualExpense?

  @@index([clientId])
  @@index([status])
  @@index([dealType])
  @@index([createdAt])
  @@index([trackingId])
}

/// Real post-order expense vs estimation (calculation / invoice)
model ActualExpense {
  id                   String   @id @default(cuid())
  projectId            String   @unique
  project              Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Client paid / quoted total in USD
  totalAmountUsd       Float?
  /// Deductions in USD (fees, discounts, etc.)
  deductionUsd         Float?
  /// Remaining after deduction (USD) — auto-filled, editable override
  remainingAmountUsd   Float?
  /// PKR per 1 USD used for conversions
  usdRate              Float    @default(280)
  productionCostPkr    Float?
  shippingCostPkr      Float?
  totalWeightKg        Float?
  /// Optional override; otherwise shippingCost / weight
  shippingPerKgPkr     Float?
  /// ISO-ish country name
  shipToCountry        String?
  /// Auto production+shipping unless overridden
  totalExpensePkr      Float?
  /// Auto remainingPkr − totalExpense unless overridden
  profitPkr            Float?
  /// PAYPAL | WISE | PAYONEER | BANK | OTHER
  paymentMethod        String?
  notes                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

/// Saved calculator snapshot (Mailer Box or Rigid Box)
model Calculation {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// "MAILER_BOX" | "RIGID_BOX"
  type      String
  /// User-provided label, e.g. "Initial estimate Q1"
  label     String?
  /// Full input parameters + cost breakdown snapshot (JSON)
  snapshot  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([type])
  @@index([createdAt])
}

/// ─────────────────────────────────────────────────────────────────────────────

/// Saved packaging quotation drafts (Invoice Generator)
model Invoice {
  id          String   @id @default(cuid())
  quoteNo     String
  clientName  String   @default("")
  clientEmail String   @default("")
  orderTitle  String   @default("")
  currency    String   @default("USD") // PKR | USD
  quantity    Int?
  unitPrice   Float?
  totalAmount Float?
  /// Optional link to a client project
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  /// Full form draft for reload/edit (JSON)
  payload     Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([quoteNo])
  @@index([createdAt])
  @@index([clientName])
  @@index([projectId])
}
