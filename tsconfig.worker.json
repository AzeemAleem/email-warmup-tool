{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2017",
    "downlevelIteration": true,
    "noEmit": false,
    "outDir": "dist/worker",
    "jsx": "react"
  },
  "include": ["src/worker/**/*.ts", "src/lib/**/*.ts", "src/types/**/*.ts"],
  "exclude": ["node_modules"]
}
